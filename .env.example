# GEMINI_API_KEY: Required for Gemini AI Chess Coach API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign session tokens (server-side only).
JWT_SECRET=

# OWNER_INITIAL_PASSWORD: Optional initial password for @lmxynnn Owner account.
# If left empty, @lmxynnn can claim their password directly via the first-run setup UI.
OWNER_INITIAL_PASSWORD=
